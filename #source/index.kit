<!--
  Landing page template for TokKontrol.
  Contains metadata, external styles, Swiper assets, and imported sections.
-->
<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Электрик на дом с гарантией | ТокКонтроль – Срочный выезд за 60 минут</title>
    <meta name="description" content="Профессиональные услуги электрика с выездом на дом. Замена проводки, сборка щитков, установка розеток и светильников. Гарантия 3 года, честные цены, работа по договору. Звоните!">
    <meta name="keywords" content="электрик на дом, вызвать электрика, услуги электрика, замена проводки, сборка электрощита, срочный вызов электрика, электрик недорого, монтаж электрики">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://tokkontrol42.ru/">
    <meta name="theme-color" content="#0A192F">
    <meta name="msapplication-TileColor" content="#0A192F">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://tokkontrol42.ru/">
    <meta property="og:title" content="ТокКонтроль – Профессиональный электрик с выездом на дом">
    <meta property="og:description" content="Срочный выезд за 60 минут. Гарантия 3 года на все работы. Честная смета без скрытых доплат.">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:site_name" content="ТокКонтроль">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="./css/main.css">
    <link rel="stylesheet" href="./vendor/swiper/swiper-bundle.min.css">
    <link rel="apple-touch-icon" sizes="180x180" href="./img/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="./img/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="./img/favicon/favicon-16x16.png" />
    <link rel="manifest" href="./img/favicon/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <script src="./vendor/swiper/swiper-bundle.min.js" defer></script>
  </head>
  <body> 
    <!-- @import './partials/header.html' -->
    <!-- @import './partials/swiper.html' -->

    <main class="main">
      <section class="services" id="services">
        <div class="container">
          <div class="services__header">
            <span class="services__label">Что мы делаем</span>
            <h2 class="services__title">Наши услуги</h2>
            <p class="services__subtitle">Полный спектр электромонтажных работ в Кемерово и области. Работаем по договору с гарантией до 3 лет.</p>
          </div>
        </div>
        <div class="services__cta">
          <p class="services__cta-text">Не нашли нужную услугу?</p>
          <button class="btn btn-primary" data-action="form">Получить консультацию</button>
        </div>
      </section>

      <section class="advantages" id="advantages">
        <div class="container">
          <div class="advantages__header">
            <span class="advantages__label">Почему мы</span>
            <h2 class="advantages__title">3 причины доверить электрику нам</h2>
            <p class="advantages__subtitle">Мы не просто «меняем розетки». Мы строим безопасную и надежную электросистему для вашего дома или бизнеса.</p>
          </div>
        </div>
      </section>

      <section class="portfolio" id="portfolio">
        <div class="container">
          <div class="portfolio__header">
            <span class="portfolio__label">Наши работы</span>
            <h2 class="portfolio__title">Выполненные проекты</h2>
            <p class="portfolio__subtitle">Более 500 объектов в Кемерово и области. От квартир до промышленных цехов.</p>
          </div>

          <div class="portfolio__filters">
            <button class="portfolio__filter-btn btn--active" data-filter="all">Все работы</button>
            <button class="portfolio__filter-btn" data-filter="apartment">Квартиры</button>
            <button class="portfolio__filter-btn" data-filter="house">Дома</button>
            <button class="portfolio__filter-btn" data-filter="commercial">Коммерция</button>
          </div>

          <div class="grid" id="portfolio-grid"></div>
        </div>
      </section>

      <!-- @import './partials/section-calculator.html' -->

      <section class="steps" id="steps">
        <div class="container">
          <div class="steps__header">
            <span class="steps__label">Как мы работаем</span>
            <h2 class="steps__title">5 шагов от заявки до результата</h2>
            <p class="steps__subtitle">Прозрачный процесс без скрытых этапов и неожиданных доплат.</p>
          </div>

          <div class="steps__grid">
            <div class="step-card">
              <div class="step-card__number">01</div>
              <div class="step-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <h3 class="step-card__title">Заявка</h3>
              <p class="step-card__text">Вы оставляете заявку на сайте или звоните. Менеджер уточняет детали и согласует удобное время.</p>
            </div>
            <div class="step-card">
              <div class="step-card__number">02</div>
              <div class="step-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="2" width="16" height="20" rx="2"/>
                  <line x1="8" y1="6" x2="16" y2="6"/>
                  <line x1="8" y1="10" x2="10" y2="10"/>
                  <line x1="12" y1="10" x2="14" y2="10"/>
                  <line x1="16" y1="10" x2="16" y2="10"/>
                  <line x1="8" y1="14" x2="10" y2="14"/>
                  <line x1="12" y1="14" x2="14" y2="14"/>
                  <line x1="16" y1="14" x2="16" y2="14"/>
                  <line x1="8" y1="18" x2="10" y2="18"/>
                  <line x1="12" y1="18" x2="14" y2="18"/>
                  <line x1="16" y1="18" x2="16" y2="18"/>
                </svg>
              </div>
              <h3 class="step-card__title">Расчёт стоимости</h3>
              <p class="step-card__text">Мастер приезжает на объект, проводит замеры и составляет детальную смету. Цена фиксируется в договоре.</p>
            </div>
            <div class="step-card">
              <div class="step-card__number">03</div>
              <div class="step-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
              </div>
              <h3 class="step-card__title">Договор</h3>
              <p class="step-card__text">Подписываем официальный договор с гарантией 3 года. Вы получаете копию на руки.</p>
            </div>
            <div class="step-card">
              <div class="step-card__number">04</div>
              <div class="step-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
              </div>
              <h3 class="step-card__title">Монтаж</h3>
              <p class="step-card__text">Бригада выполняет работы в согласованные сроки. Убираем за собой, выносим мусор.</p>
            </div>
            <div class="step-card">
              <div class="step-card__number">05</div>
              <div class="step-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </div>
              <h3 class="step-card__title">Сдача объекта</h3>
              <p class="step-card__text">Проверяем всё вместе с вами, подписываем акт приёмки. Вы получаете гарантийный талон.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="team" id="team">
        <div class="container">
          <div class="team__header">
            <span class="team__label">Наши мастера</span>
            <h2 class="team__title">Команда профессионалов</h2>
            <p class="team__subtitle">Все сотрудники штатные, с профильным образованием и действующими допусками по электробезопасности.</p>
          </div>

          <div class="team__grid">
            <div class="team-card">
              <div class="team-card__image-wrapper">
                <img src="./img/content/team/master-ivan.png" alt="Иван Сидоров" class="team-card__image" loading="lazy">
                <span class="team-card__experience">12 лет опыта</span>
              </div>
              <div class="team-card__content">
                <h3 class="team-card__name">Иван Сидоров</h3>
                <p class="team-card__position">Старший электрик</p>
                <div class="team-card__badges">
                  <span class="team-card__badge">Допуск до 1000В</span>
                  <span class="team-card__badge">Группа IV</span>
                </div>
                <p class="team-card__desc">Специализируется на сложных промышленных объектах и сборке распределительных щитов.</p>
              </div>
            </div>
            <div class="team-card">
              <div class="team-card__image-wrapper">
                <img src="./img/content/team/master-ivan.png" alt="Алексей Кузнецов" class="team-card__image" loading="lazy">
                <span class="team-card__experience">8 лет опыта</span>
              </div>
              <div class="team-card__content">
                <h3 class="team-card__name">Алексей Кузнецов</h3>
                <p class="team-card__position">Электрик-универсал</p>
                <div class="team-card__badges">
                  <span class="team-card__badge">Допуск до 1000В</span>
                  <span class="team-card__badge">Группа III</span>
                </div>
                <p class="team-card__desc">Мастер на все руки: от замены розетки до полной разводки электрики в новостройке.</p>
              </div>
            </div>
            <div class="team-card">
              <div class="team-card__image-wrapper">
                <img src="./img/content/team/master-ivan.png" alt="Сергей Морозов" class="team-card__image" loading="lazy">
                <span class="team-card__experience">15 лет опыта</span>
              </div>
              <div class="team-card__content">
                <h3 class="team-card__name">Сергей Морозов</h3>
                <p class="team-card__position">Инженер-проектировщик</p>
                <div class="team-card__badges">
                  <span class="team-card__badge">Проектировщик</span>
                  <span class="team-card__badge">Умный дом</span>
                </div>
                <p class="team-card__desc">Разрабатывает проекты электроснабжения, занимается автоматизацией и слаботочными системами.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="reviews" id="reviews">
        <div class="container">
          <div class="reviews__header">
            <span class="reviews__label">Отзывы клиентов</span>
            <h2 class="reviews__title">Что говорят о нас</h2>
            <p class="reviews__subtitle">Более 500 довольных клиентов в Кемерово и области. Средний рейтинг 4.9 из 5.</p>
          </div>

          <div class="reviews__grid" id="reviews__grid"></div>
        </div>
      </section>

      <!-- @import './partials/section-contact.html' -->
    </main>

    <!-- @import './partials/footer.html' -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script type="module" src="./js/main.js"></script>
  </body>
</html>